# ==============================================
# BittuGPT Environment Configuration Template
# Copy this file to .env and fill in your actual keys:
# cp .env.example .env
# ==============================================

# Google Gemini API Key (Required for Agent and RAG Embeddings)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Gemini Model Selection (e.g., gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash)
GOOGLE_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Tavily API Key (Required for Agent Web Search tool)
# Get your key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith Observability & Tracing (Optional - set to true to enable)
# Get your key at: https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=bittugpt
